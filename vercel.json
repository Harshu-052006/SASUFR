{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sasufr": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "buildCommand": "pip install -r requirements.txt && pip install --no-deps face-recognition==1.3.0"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "sasufr"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
